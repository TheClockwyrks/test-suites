# What Prettier must not touch. This file is the whole of the format gate's
# scope: a path is formatted unless it is excluded here or Prettier has no
# parser for it (Rust, shell and TOML need no entry).

# --- Generated or vendored -------------------------------------------------

node_modules/
target/
# What a package of the npm workspace builds into its own dist/.
dist/
# npm writes this file and its formatting is npm's own.
package-lock.json
# Copier writes the answers file on every render and update, in its own
# formatting.
.copier-answers.yml
# The environment uv builds for the ci project.
.venv/
# Scratch work, which nobody formats.
/tmp/

# --- Prose -----------------------------------------------------------------

# Markdown style is markdownlint's.
*.md
*.mdx

# --- The catalog -----------------------------------------------------------

# The frozen test-case versions are left out too, but not here:
# scripts/format-check.mjs, which `npm run format:check` runs, derives them
# from their `.frozen` markers on every run, so the list never goes stale.
# A lattice scenario is the designer's to write (tools/lattice-designer), in
# the layout it saves, which .markdownlint-cli2.yaml and cspell.json leave out
# too.
/test-cases/performance/hard/lattice/*/cases/*.json
# The Handlebars templates, which Prettier does not parse.
/**/*.hbs
# What a case vendors or a build writes, and the scratch a tool leaves.
build/
/**/.vendor/**
/**/vendor/**
